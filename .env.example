# Variáveis lidas pelo docker-compose.yml (o Docker Compose carrega
# automaticamente um ficheiro ".env" nesta pasta, se existir).
#
# Os valores por omissão (definidos com ${VAR:-omissao} no compose) já
# funcionam sem copiares este ficheiro. Só precisas de um ".env" aqui se
# quiseres mudar alguma coisa — por exemplo, se a porta 8000 ou 8080 já
# estiver ocupada na tua máquina.

POSTGRES_USER=pitwall
POSTGRES_PASSWORD=pitwall
POSTGRES_DB=pitwall

# Porta no teu PC (host) que aponta para o Postgres dentro do container.
POSTGRES_PORT=5433

# Portas no teu PC para a API (backend) e para a interface web (frontend).
BACKEND_PORT=8000
FRONTEND_PORT=8080
