# Copy this file to .env and adjust values for your local setup.

APP_NAME=PitWall
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1

# PostgreSQL connection (used from Phase 2 onwards)
DATABASE_URL=postgresql+psycopg://pitwall:pitwall@localhost:5432/pitwall

# FastF1 caches downloaded session data locally to avoid re-fetching
FASTF1_CACHE_DIR=.fastf1_cache

# Jolpica-F1 (Ergast-compatible) API, used for historical results/standings
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Comma-separated list, parsed into CORS_ORIGINS by pydantic-settings
CORS_ORIGINS=["http://localhost:5173"]
