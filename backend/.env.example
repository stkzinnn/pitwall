# Copy this file to .env and adjust values for your local setup.

APP_NAME=PitWall
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1

# PostgreSQL connection (async driver — matches docker-compose.yml service "db").
# Host port is 5433, not 5432, to avoid clashing with a locally-installed
# PostgreSQL service; change back to 5432 if that doesn't apply to you.
DATABASE_URL=postgresql+asyncpg://pitwall:pitwall@localhost:5433/pitwall

# FastF1 caches downloaded session data locally to avoid re-fetching
FASTF1_CACHE_DIR=.cache/fastf1

# Jolpica-F1 (Ergast-compatible) API, used for historical results/standings
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Comma-separated list, parsed into CORS_ORIGINS by pydantic-settings
CORS_ORIGINS=["http://localhost:5173"]
